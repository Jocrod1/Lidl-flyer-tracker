# Local development only. Never use these values for production services.
DATABASE_URL=postgresql://lidl:lidl@localhost:5432/lidl_dev

R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minio
R2_SECRET_ACCESS_KEY=minio-password
R2_BUCKET_NAME=lidl-dev

LIDL_SMTP_HOST=localhost
LIDL_SMTP_PORT=1025
LIDL_SMTP_USE_TLS=0
LIDL_SMTP_FROM=dev@localhost

LIDL_WATCH_RAW_DIR=.local/raw
LIDL_WATCH_CACHE_DIR=.local/cache
LIDL_WATCH_STATE_PATH=.local/watch_state.json
